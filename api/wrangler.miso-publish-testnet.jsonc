{
  // Dedicated, service-binding-only onara for the Miso share-pool publish/consume flow.
  // No routes + workers_dev:false => unreachable except via in-account service bindings.
  // Sponsor key: SUI_MNEMONIC secret (set separately). Sponsor address is the SPONSOR
  // baked into the share-template gate.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miso-publish-onara-testnet",
  "account_id": "13d90b7944bae6a8f811ceaca303eca6",
  "main": "src/workers.ts",
  "compatibility_date": "2026-02-26",
  "workers_dev": false,
  "vars": {
    "SUI_NETWORK": "testnet",
    "SUI_GRPC_URL": "https://fullnode.testnet.sui.io"
  },
  "services": [
    { "binding": "HAYABUSA", "service": "miso-hayabusa-testnet" }
  ]
}
