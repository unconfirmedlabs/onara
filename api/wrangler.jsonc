{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onara",
  "main": "src/workers.ts",
  "compatibility_date": "2026-02-26",
  "routes": [
    {
      "pattern": "onara.example.com",
      "custom_domain": true
    }
  ],
  // Optional: hard server-side cap on gas budget, in MIST (decimal string).
  // Enforced before policy matching on both /sponsor and /sponsor/ws.
  // "vars": {
  //   "GAS_BUDGET_MAX": "50000000000"
  // },
  // Provision the sponsor's Bech32 `suiprivkey...` separately:
  //   wrangler secret put SUI_PRIVATE_KEY
  // The same key signs sponsored transactions and dynamic authorization
  // requests; its public address is derived at runtime.
  // Optional: enable sponsorship analytics
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "ANALYTICS",
  //     "dataset": "sponsorship"
  //   }
  // ],
  // Optional: per-sender and per-IP rate limiting (period must be 10 or 60 seconds)
  // "unsafe": {
  //   "bindings": [
  //     {
  //       "name": "SENDER_RATE_LIMIT",
  //       "type": "ratelimit",
  //       "namespace_id": "1001",
  //       "simple": { "limit": 10, "period": 60 }
  //     },
  //     {
  //       "name": "IP_RATE_LIMIT",
  //       "type": "ratelimit",
  //       "namespace_id": "1002",
  //       "simple": { "limit": 30, "period": 60 }
  //     }
  //   ]
  // },
  // Optional: KV namespace used to cache dynamic authorization allow decisions
  // for requirements with `check.cacheTtlSeconds > 0`. Without this binding,
  // dynamic authorization decisions are never cached.
  // "kv_namespaces": [
  //   { "binding": "DYNAMIC_AUTHORIZATION_CACHE", "id": "<kv-namespace-id>" }
  // ]
}
