{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onara",
  "main": "src/workers.ts",
  "compatibility_date": "2026-02-26",
  "routes": [
    {
      "pattern": "onara.example.com",
      "custom_domain": true
    }
  ],
  // Optional: hard server-side cap on gas budget, in MIST (decimal string).
  // Enforced before policy matching on both /sponsor and /sponsor/ws.
  // "vars": {
  //   "GAS_BUDGET_MAX": "50000000000"
  // },
  // Every `senders.dynamic.signingKeyEnv` names a Worker secret containing a
  // Bech32 `suiprivkey...`. Provision each one separately, for example:
  //   wrangler secret put MY_APP_ONARA_SIGNING_KEY
  // The matching public address must be pinned in that policy's
  // `senders.dynamic.signingIdentity` field.
  // Prefer a dedicated request-signing key per external trust domain; do not
  // reuse the sponsor gas key or put a raw private key in policy JSON/vars.
  // Optional: enable sponsorship analytics
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "ANALYTICS",
  //     "dataset": "sponsorship"
  //   }
  // ],
  // Optional: per-sender and per-IP rate limiting (period must be 10 or 60 seconds)
  // "unsafe": {
  //   "bindings": [
  //     {
  //       "name": "SENDER_RATE_LIMIT",
  //       "type": "ratelimit",
  //       "namespace_id": "1001",
  //       "simple": { "limit": 10, "period": 60 }
  //     },
  //     {
  //       "name": "IP_RATE_LIMIT",
  //       "type": "ratelimit",
  //       "namespace_id": "1002",
  //       "simple": { "limit": 30, "period": 60 }
  //     }
  //   ]
  // },
  // Optional: KV namespace used to cache dynamic sender allow decisions for
  // policies with `senders.dynamic.cacheTtlSeconds > 0`. Without this
  // binding, dynamic sender checks are never cached.
  // "kv_namespaces": [
  //   { "binding": "DYNAMIC_SENDERS_CACHE", "id": "<kv-namespace-id>" }
  // ]
}
