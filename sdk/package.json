    "blockchain"
  ],
  "peerDependencies": {
    "@mysten/sui": "^2.5.0"
  },
  "devDependencies": {
    "@mysten/sui": "^2.5.0",
    "@types/bun": "^1.3.9",
    "typescript": "^5.7.0"
  }
}
