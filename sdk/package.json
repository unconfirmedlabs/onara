{
  "name": "@unconfirmed/onara",
  "version": "0.3.0",
  "description": "TypeScript client SDK for Onara — a policy-based Sui transaction sponsorship (gas station) server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
