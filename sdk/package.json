{
  "name": "@unconfirmed/onara",
  "version": "0.3.0",
  "description": "TypeScript client SDK for Onara — a policy-based Sui transaction sponsorship (gas station) server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:package": "bun scripts/check-package.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unconfirmedlabs/onara",
    "directory": "sdk"
  },
  "keywords": [
    "sui",
    "onara",
    "gas-station",
    "sponsorship",
    "sponsored-transactions",
    "web3",
    "blockchain"
  ],
  "peerDependencies": {
    "@mysten/bcs": "^2.1.1",
    "@mysten/sui": "^2.28.0",
    "@unconfirmed/sui-effect": "^0.1.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@mysten/bcs": "2.1.1",
    "@mysten/sui": "2.30.0",
    "@types/bun": "^1.4.0",
    "@unconfirmed/sui-effect": "^0.1.2",
    "effect": "4.0.0-rc.112",
    "typescript": "^7.0.2"
  }
}
